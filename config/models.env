# the terms of the GNU General Public License v3.0 or later.
# See <https://www.gnu.org/licenses/gpl-3.0-standalone.html>.

# =====================================================
# OffgridDev model configuration (low → high VRAM)
# =====================================================
# Set 1 = enabled, 0 = disabled
#

# -----------------------------
# Qwen (coder-first, recommended)
# -----------------------------

ENABLE_QWEN25_CODER_0P5B=0
# GPU VRAM Required: ~1 GB | Disk: ~0.4 GB
# Smallest tier, tiny/integrated GPUs only

ENABLE_QWEN25_CODER_1P5B=0
# GPU VRAM Required: ~2 GB | Disk: ~1 GB
# Very lightweight autocomplete

ENABLE_QWEN25_CODER_3B=1
# GPU VRAM Required: ~2 GB | Disk: ~3 GB
# Fast autocomplete, lightweight

ENABLE_QWEN25_CODER_7B=1
# GPU VRAM Required: ~4–6 GB | Disk: ~5–6 GB
# DEFAULT: best balance for most systems

ENABLE_QWEN25_CODER_14B=0
# GPU VRAM Required: ~10 GB | Disk: ~9 GB
# Stronger reasoning, mid-tier GPUs

ENABLE_QWEN25_CODER_32B=0
# GPU VRAM Required: ~20–22 GB | Disk: ~20+ GB
# High-end only

# -----------------------------
# Qwen3 Coder (MoE, 30B total / 3.3B active)
# -----------------------------

ENABLE_QWEN3_CODER_30B=0
# GPU VRAM Required: ~20 GB | Disk: ~19 GB
# High-end only. Ollama's other official tag, 480b-a35b (~290+ GB disk),
# is outside this project's supported hardware range and is not offered here.

# -----------------------------
# Devstral (Mistral, agentic coding)
# -----------------------------

ENABLE_DEVSTRAL_24B=0
# GPU VRAM Required: ~16 GB | Disk: ~14 GB
# High-end only

# -----------------------------
# DeepSeek (reasoning + code)
# -----------------------------

ENABLE_DEEPSEEK_CODER_1P3B=0
# GPU VRAM Required: ~1–2 GB | Disk: ~2 GB
# Very limited, not recommended unless GPU is tiny

ENABLE_DEEPSEEK_CODER_6P7B=1
# GPU VRAM Required: ~6–7 GB | Disk: ~6–7 GB
# Closest DeepSeek equivalent to Qwen 7B

ENABLE_DEEPSEEK_CODER_33B=0
# GPU VRAM Required: ~18–20 GB | Disk: ~18–20 GB
# High-end only

# -----------------------------
# Gemma (general / analysis)
# -----------------------------

ENABLE_GEMMA3_2B=0
# GPU VRAM Required: ~2 GB | Disk: ~2–3 GB
# Lightweight general assistant

ENABLE_GEMMA3_7B=1
# GPU VRAM Required: ~5–6 GB | Disk: ~6 GB
# General-purpose alternative to Qwen 7B

ENABLE_GEMMA4_E4B=0
# GPU VRAM Required: ~6–8 GB | Disk: ~8–10 GB
# MoE, good reasoning, not coder-specialist

ENABLE_GEMMA4_26B_A4B=0
# GPU VRAM Required: ~10–12 GB | Disk: ~16 GB
# 


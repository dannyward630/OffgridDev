# .gitignore - special file for Git telling it which files to ignore when committing changes to the repository

# Ignore all data files except the one that's tracked
# Example: .csv
# Example: !sample-data.csv

# Ignore RStudio project files/folders
.Rproj.user/
*.Rproj

# Ignore R cache and history
.RData
.RHistory
.Rhistory
.Ruserdata
.Rapp.history

# Ignore OS cruft
.DS_Store
Thumbs.db

# Ignore Logs
*.log
log.txt
logs.txt
logs/*

# Ignore Editor cruft
.vscode/
.idea/
*.swp

# Ignore AI coding tool configuration files, except AGENTS.md
.claude
.claude/*
.claudecode/*
.gemini
.gemini/*
.github/copilot-instructions.md
.github-copilot
.github-copilot/*
.kimi
CLAUDE.md
CLAUDECODE.md
CONVENTIONS.md
GEMINI.md
KIMI.md
CODEX.md
CHATGPT.md

# Ignore cache files
*.cache
__pycache__/
.venv/

# Ignore OffgridDev runtime data - downloaded models, generated keys, local databases,
# and caches. The launcher scripts (scripts/offgriddev.ps1, .sh) recreate this directory
# automatically; never commit it. It currently holds multi-GB Ollama model blobs, an
# SSH keypair Ollama generates for registry auth (data/ollama/id_ed25519*), and Open
# WebUI's local user/chat SQLite database (data/open-webui/webui.db*) - all sensitive
# and/or regenerable, never something to check in.
data/

# Ignore local secrets and credential files
.env
.env.local
.env.*.local
*.pem
*.key
*.pfx
*.p12
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*credentials*.json

# Ignore temp/scratch files
*.tmp
*.temp
*.bak
*.orig
